// mainJuego.wpgm
import wollok.game.*
import zombies.*
import plantas.*
import jardin.*

program PlantasVsZombies {
  game.width(10)
  game.height(6)
  game.cellSize(220)

  jardin.plantar()

  const tickSpawn = game.tick(10000, { generadorDeZombies.generar() }, false)
  tickSpawn.start()

  // const tickColisiones = game.tick(100, { jardin.chequearColisiones() },false)
  // tickColisiones.start()

  game.start()
}

